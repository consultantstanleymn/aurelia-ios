<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The tutor's provider key lives in the Keychain, access-grouped under the service prefix
	     below. Written while the app is in the foreground (you paste it in Settings) and read back
	     on every turn, which can happen with the device locked but not before the first unlock
	     after boot, so AfterFirstUnlock is the right class rather than WhenUnlocked. -->
	<key>keychain-access-groups</key>
	<array>
		<string>ch.stanley.studybuddy</string>
	</array>
</dict>
</plist>
